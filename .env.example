# Ключи используются ТОЛЬКО в server route (src/app/api/**),
# в клиентский бандл не попадают и префикса NEXT_PUBLIC_ не получают.
# Реальные значения кладём в .env.local, который не коммитится.
# Оба необязательны: без ключей пересказ заменяется текстом из причин движка.

# Основной провайдер: Google Gemini (бесплатный тариф, https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Необязательно: переопределить модель Gemini
GEMINI_MODEL=
# Запасной провайдер: Anthropic Claude Haiku
ANTHROPIC_API_KEY=
