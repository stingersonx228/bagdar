# Ключи используются ТОЛЬКО в server route (src/app/api/**),
# в клиентский бандл не попадают и префикса NEXT_PUBLIC_ не получают.
# Реальные значения кладём в .env.local (и в Environment Variables на Vercel).
# Все необязательны. Роут пробует провайдеров по очереди сверху вниз;
# если не ответил никто — интерфейс показывает текст из причин движка.

# 1. Google Gemini — бесплатный тариф: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=
# 2. Groq — бесплатный тариф: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=
# 3. OpenRouter — бесплатные модели с суффиксом :free: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
